[flake8]
max-line-length = 120
max-complexity = 10

# E203 and W503 conflict with black-style formatting of slices and operators.
extend-ignore =
    E203,
    E402,
    W503

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache,
    logs,
    spark-warehouse,
    metastore_db

# Unused imports are expected in package re-export modules.
per-file-ignores =
    __init__.py: F401

show-source = true
statistics = true
count = true
